---
import { site } from '../data/site';
---

<header class="site-header">
  <nav class="shell nav" aria-label="Primary navigation">
    <a class="brand" href="#top" aria-label={`${site.name} home`}>
      <span class="brand-mark">{site.initials}</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <div class="nav-links">
      <a href="/#about">About</a>
      <a href="/#work">Work</a>
      <a href="/#skills">Skills</a>
      <a href="/#contact">Contact</a>
    </div>

    <a class="nav-cta" href={site.resume}>Resume <span aria-hidden="true">↗</span></a>
  </nav>
</header>
