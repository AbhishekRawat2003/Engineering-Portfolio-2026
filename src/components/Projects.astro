---
import { projects } from '../data/site';
---

<section class="section" id="work">
  <div class="shell">
    <div class="section-heading" data-reveal>
      <div class="section-kicker inline">
        <span>02</span>
        <p>Selected work</p>
      </div>
      <h2>Projects designed to show <em>how I think.</em></h2>
      <p>Less “technology showcase”, more problem → decisions → engineering → outcome.</p>
    </div>

    <div class="project-list">
      {projects.map((project) => (
        <article class="project-card" data-reveal>
          <div class="project-number">{project.index}</div>
          <div class="project-main">
            <div class="project-meta">
              <span>{project.type}</span>
              <span>Featured project</span>
            </div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="tags">
              {project.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </div>
          <div class="project-actions">
            <a href={project.demo} aria-label={`Open ${project.title} live demo`}>Live ↗</a>
            <a href={project.github} aria-label={`Open ${project.title} GitHub repository`}>Code ↗</a>
             <a href={`/projects/${project.slug}`}>Case Study ↗</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
